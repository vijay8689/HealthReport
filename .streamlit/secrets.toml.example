# Copy to .streamlit/secrets.toml (ignored by Git), or use Streamlit Cloud secrets.
SUPABASE_URL = "https://your-project.supabase.co"
# Publishable key or legacy anon JWT. Never use a secret/service_role key for login.
SUPABASE_ANON_KEY = "sb_publishable_replace_me"

# Optional: integrated-embedding Pinecone index for report persistence.
# PINECONE_API_KEY = "replace_me"
# PINECONE_INDEX_NAME = "healthlens"

# Set this to your deployed HTTPS app URL when hosting remotely.
APP_URL = "http://localhost:8501"
